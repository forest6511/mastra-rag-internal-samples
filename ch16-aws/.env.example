# この章で使う値。.env にコピーして入れる（.env は git に入れない）
ATL_SITE=https://<サイト名>.atlassian.net
ATL_EMAIL=you@example.com
ATL_TOKEN=
OPENAI_API_KEY=
DATABASE_URL=postgres://rag:ragpass@localhost:55432/rag
GH_ORG=
GH_RAG_TOKEN=
SLACK_TOKEN=
# 第14章: アプリのトークン（xapp-。Socket Mode の接続に使う）
SLACK_APP_TOKEN=
SLACK_WORKSPACE=kanadeloop
NOTION_TOKEN=
NOTION_ROOT_PAGE=
# 第15章: MCP の利用者ごとのトークン（openssl rand -hex 24 などで作る）
MCP_TOKEN_KOBAYASHI=
MCP_TOKEN_NAKAMURA=
# トンネルで試すときのホスト名（カンマ区切り）
MCP_ALLOWED_HOSTS=
