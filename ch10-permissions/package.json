  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-pgvector": "0.0.11",
    "@eslint/js": "10.0.1",
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
